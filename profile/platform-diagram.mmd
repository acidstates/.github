flowchart TD
  PLAT["platform — the monorepo — frameworks · shared libs · tools · stands · infra"]
  PKG["@acidstates/gamecore · protocol · core · ui · audio · gc-sdk · brands → GitHub Packages — acidstates-gamemodule · acidstates-simbot → PEP 503 index on DO Spaces"]
  GAMES["game repos — one per game — the-reactor · solvent · game-template → game-template-2.0"]
  CAT["catalog — slug → {module, client} + math versions"]
  CI["acidstates/workflows — ci → build → DOCR → deploy → healthcheck → auto-rollback"]
  STANDS["stands — statehub (QA · catalog) · betmanager (accounts · wallet · analytics · admin) · studios (symbol-landing · spin-animation · board-transformation) with MCP"]
  LIVE["droplet — games · statehub · betmanager · studios — nginx + oauth2-proxy, GitHub-org SSO on internal hosts"]
  PLAT -->|publishes SemVer| PKG
  PKG -->|installed by| GAMES
  GAMES -->|game-manifest.json| CAT
  GAMES -->|merge to main| CI
  PLAT -->|merge to main| CI
  CAT --> STANDS
  CI --> LIVE
  STANDS --> LIVE
  classDef acid stroke:#C6F000,stroke-width:2px
  class PLAT,LIVE acid
