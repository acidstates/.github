flowchart TD
  PLAT["platform — the monorepo — frameworks · shared libs · tools · stands · infra"]
  PKG["@acidstates/gamecore · protocol · core · ui · gc-sdk · brands → GitHub Packages — acidstates-gamemodule → PEP 503 index on DO Spaces"]
  GAMES["game repos — one per game — the-reactor · solvent · game-template"]
  CAT["catalog — slug → {module, client} + math versions"]
  CI["acidstates/workflows — ci → build → DOCR → deploy → healthcheck → auto-rollback"]
  STANDS["stands — statehub (QA) · betmanager (accounts · wallet · analytics)"]
  LIVE["droplet — game · statehub · betmanager — nginx + oauth2-proxy, GitHub-org SSO on internal hosts"]
  PLAT -->|publishes SemVer| PKG
  PKG -->|installed by| GAMES
  GAMES -->|game-manifest.json| CAT
  GAMES -->|merge to main| CI
  PLAT -->|merge to main| CI
  CAT --> STANDS
  CI --> LIVE
  STANDS --> LIVE
  classDef acid stroke:#C6F000,stroke-width:2px
  class PLAT,LIVE acid
